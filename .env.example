# Local evaluation only. Never expose sandbox mode to untrusted users.
NEWSROOM_MODE=sandbox
APP_URL=http://localhost:3000
DATA_DIR=.data
WORKER_POLL_MS=2000
# Exact admin-reviewed public hosts for environments whose trusted egress proxy resolves DNS.
# Other hosts require local public DNS resolution and destination pinning. Add redirects explicitly.
SOURCE_PROXY_TRUSTED_HOSTS=www.tbsnews.net,www.prothomalo.com,www.thedailystar.net,www.kalerkantho.com
# For production set NEWSROOM_MODE=production and configure all required services.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_MEDIA_BUCKET=newsroom-media
DATABASE_URL=postgresql://newsroom:local-development-only@localhost:5432/newsroom
DATABASE_SSL=false
# Generate with: openssl rand -hex 32. Keep stable and backed up securely.
ENCRYPTION_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=
# Enter the current price for your selected model; blank means unknown, never free.
OPENAI_INPUT_USD_PER_MILLION=
OPENAI_OUTPUT_USD_PER_MILLION=
# Official provider contracts are not enabled until current documentation is verified.
CANVA_DOCS_VERIFIED=false
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
CANVA_ACCESS_TOKEN=
CANVA_API_CONFIG=
META_DOCS_VERIFIED=false
META_CLIENT_ID=
META_CLIENT_SECRET=
META_ACCESS_TOKEN=
META_API_CONFIG=
BUFFER_DOCS_VERIFIED=false
BUFFER_CLIENT_ID=
BUFFER_CLIENT_SECRET=
BUFFER_ACCESS_TOKEN=
BUFFER_API_CONFIG=
# No paid or free image service is implied. Authorized user uploads work without one.
IMAGE_PROVIDER=
IMAGE_PROVIDER_API_KEY=
# Docker local database only; replace for a deployment.
POSTGRES_PASSWORD=local-development-only
